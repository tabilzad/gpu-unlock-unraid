Menu="Utilities"
Type="xmenu"
Title="GPU Unlock"
Icon="unlock"
Markdown="false"
---
<?PHP
/* SPDX-License-Identifier: GPL-2.0-only
 * GPU Unlock for Unraid: status and settings page. https://github.com/tabilzad/gpu-unlock-unraid
 * Everything shown comes from `gpu-unlock-ctl status --json`; the buttons post
 * to include/exec.php (fixed action table, CSRF enforced by Unraid).
 */
$docroot ??= ($_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp');
require_once "$docroot/plugins/gpu-unlock/include/status.php";

$gu = gu_status();
$gu_cards = is_array($gu['cards'] ?? null) ? $gu['cards'] : [];
$gu_modules = is_array($gu['modules'] ?? null) ? $gu['modules'] : [];
$gu_log = is_array($gu['kernel_log'] ?? null) ? $gu['kernel_log'] : [];
$gu_fwlog = is_array($gu['firmware_log'] ?? null) ? $gu['firmware_log'] : [];
$gu_targets = (string) ($gu['targets'] ?? '');
$gu_source = (string) ($gu['targets_source'] ?? 'none');
$gu_fw = (string) ($gu['firmware_state'] ?? (!empty($gu['firmware_present']) ? 'present' : 'missing'));
$gu_selected = $gu_targets === '' ? [] : explode(',', $gu_targets);
$gu_verdicts = [];
foreach (is_array($gu['verdicts'] ?? null) ? $gu['verdicts'] : [] as $v) {
    $gu_verdicts[(string) ($v['address'] ?? '')] = $v;
}
$gu_hook_ran = str_starts_with((string) ($gu['hook_status'] ?? ''), 'loaded:');
$gu_ready = !empty($gu['module_present']) && !empty($gu['firmware_present']) && !empty($gu['hook_installed'])
    && $gu_targets !== '' && empty($gu['disabled']);
?>
<style>
.gu-ok { color: #3c9b3c; font-weight: bold; }
.gu-bad { color: #d0342c; font-weight: bold; }
.gu-warn { color: #d08a2c; font-weight: bold; }
.gu-table td { padding: 3px 12px 3px 0; vertical-align: top; }
.gu-table td:first-child { white-space: nowrap; font-weight: bold; }
.gu-cards th { text-align: left; padding: 3px 12px 3px 0; }
.gu-cards td { padding: 3px 12px 3px 0; }
.gu-banner { border: 2px solid #d0342c; padding: 8px 12px; margin: 10px 0; }
#gu-output { max-height: 20em; overflow: auto; white-space: pre-wrap; border: 1px solid #888; padding: 6px; margin-top: 8px; }
.gu-log { white-space: pre-wrap; font-size: 90%; max-height: 14em; overflow: auto; }
.gu-buttons input { margin: 2px 6px 2px 0; }
</style>

<?php if ($gu === []): ?>
<p class="gu-bad">gpu-unlock-ctl did not answer. Reinstall the plugin, or run <code>gpu-unlock-ctl status</code> in a terminal.</p>
<?php else: ?>

<?php if (!empty($gu['power_off_required'])): ?>
<div class="gu-banner"><span class="gu-bad">Power off required.</span> A card reported that it cannot be unlocked until the server is powered off completely; a reboot is not enough. NVIDIA drives it locked for now. Shut down, wait a few seconds, and power on.</div>
<?php endif; ?>

<table class="gu-table">
<tr><td>Plugin</td><td><?= gu_h($gu['plugin_version'] ?? '') ?> (gpu_unlock <?= gu_h($gu['module_version'] ?? '') ?>, firmware <?= gu_h($gu['nv'] ?? '') ?>)</td></tr>
<tr><td>Running kernel</td><td><?= gu_h($gu['kernel'] ?? '') ?> &mdash; module on the flash drive: <?= gu_yesno(!empty($gu['module_present'])) ?></td></tr>
<?php if (($gu['pending_kernel'] ?? '') !== ''): ?>
<tr><td>Staged kernel</td><td><?= gu_h($gu['pending_kernel']) ?> (the next boot runs it) &mdash; module on the flash drive: <?= gu_yesno(!empty($gu['pending_module_present'])) ?></td></tr>
<?php endif; ?>
<tr><td>Firmware</td><td><?php if ($gu_fw === 'present'): ?><?= gu_yesno(true, 'generated') ?><?php elseif ($gu_fw === 'missing'): ?><?= gu_yesno(false, '', 'not generated yet') ?><?php else: ?><?= gu_yesno(false, '', $gu_fw . ': generate it again') ?><?php if ($gu_fw === 'incomplete'): ?> (it lacks files gpu_unlock <?= gu_h($gu['module_version'] ?? '') ?> loads; cards whose files are there are still unlocked at boot)<?php endif; ?><?php endif; ?><?php if (!empty($gu['firmware_job'])): ?> <span class="gu-ok">(generation running, this page refreshes)</span><?php endif; ?></td></tr>
<tr><td>Modprobe rule</td><td><?= gu_yesno(!empty($gu['hook_installed']), 'installed', 'not installed') ?><?php if (($gu['hook_conflict'] ?? '') !== ''): ?> <span class="gu-bad">conflict: <?= gu_h($gu['hook_conflict']) ?></span><?php endif; ?></td></tr>
<tr><td>Targets</td><td><?php if ($gu_targets === ''): ?><span class="gu-bad">none chosen</span><?php else: ?><code><?= gu_h($gu_targets) ?></code> (<?= $gu_source === 'cmdline' ? 'kernel command line, overrides the choice below' : 'chosen below' ?>)<?php endif; ?></td></tr>
<tr><td>Enabled</td><td><?= gu_yesno(empty($gu['disabled']), 'yes', 'no (disabled for the next boots)') ?><?php if (!empty($gu['safe_mode'])): ?> <span class="gu-bad">Safe Mode: the hook does nothing</span><?php endif; ?></td></tr>
<tr><td>This boot</td><td><?php if (($gu['hook_status'] ?? '') !== ''): ?><?= gu_h($gu['hook_status']) ?>; gpu_unlock <?= gu_yesno(!empty($gu['module_loaded']), 'loaded', 'not loaded') ?><?php elseif (!empty($gu['module_loaded'])): ?>gpu_unlock <span class="gu-ok">loaded</span>, but not by the hook (no record of it this boot)<?php else: ?>the hook did not run and gpu_unlock is not loaded: expected until the next boot, when the modprobe rule runs the hook as nvidia loads. Still so after a reboot means nvidia did not load (is the Nvidia-Driver plugin installed?).<?php endif; ?></td></tr>
<tr><td>Next boot</td><td><?= $gu_ready ? '<span class="gu-ok">ready: power the server off fully, then start it</span>' : '<span class="gu-bad">not ready</span>' ?></td></tr>
</table>

<p><strong>NVIDIA cards</strong> &mdash; tick the cards to unlock and save. Only cards gpu_unlock supports can be chosen; a card bound to VFIO or another driver at boot is skipped by the module itself.</p>
<?php if ($gu_cards === []): ?>
<p>No NVIDIA display controller found.</p>
<?php else: ?>
<table class="gu-cards">
<tr><th>Unlock</th><th>Address</th><th>Device id</th><th>Driver</th><th>Supported</th><th>This boot</th></tr>
<?php foreach ($gu_cards as $c): $addr = (string) ($c['address'] ?? ''); $v = $gu_verdicts[$addr] ?? null; ?>
<tr>
<td><?php if (!empty($c['supported'])): ?><input type="checkbox" class="gu-card" value="<?= gu_h($addr) ?>"<?= in_array($addr, $gu_selected, true) || $gu_targets === 'all' ? ' checked' : '' ?><?= $gu_source === 'cmdline' ? ' disabled' : '' ?>><?php endif; ?></td>
<td><code><?= gu_h($addr) ?></code></td>
<td><?= gu_h($c['device'] ?? '') ?></td>
<td><?= gu_h($c['driver'] ?? '') ?></td>
<td><?= gu_yesno(!empty($c['supported'])) ?></td>
<td><?php
if ($v === null) {
    echo $gu_hook_ran ? 'not a target' : '';
} else {
    $state = (string) ($v['state'] ?? '');
    $class = $state === 'unlocked' ? 'gu-ok' : (($state === 'pending' || $state === 'skipped') ? 'gu-warn' : 'gu-bad');
    echo '<span class="' . $class . '">' . gu_h($state) . '</span>';
    if (($v['reason'] ?? '') !== '') {
        echo ' (' . gu_h($v['reason']) . ')';
    }
    if (!empty($v['power_off'])) {
        echo ' <span class="gu-bad">power off required</span>';
    }
}
?></td>
</tr>
<?php endforeach; ?>
</table>
<p>
<label><input type="checkbox" id="gu-all"<?= $gu_targets === 'all' ? ' checked' : '' ?><?= $gu_source === 'cmdline' ? ' disabled' : '' ?>> every supported card no driver has bound yet (<code>all</code>)</label>
</p>
<div class="gu-buttons">
<input type="button" value="Save targets" onclick="guSaveTargets()"<?= $gu_source === 'cmdline' ? ' disabled title="gpu_unlock.targets= is on the kernel command line; remove it from the boot entry to choose here"' : '' ?>>
</div>
<?php endif; ?>

<?php if ($gu_log !== []): ?>
<p><strong>Kernel log (gpu_unlock and the nvidia load)</strong></p>
<pre class="gu-log"><?php foreach ($gu_log as $l): ?><?= gu_h($l) ?>
<?php endforeach; ?></pre>
<?php endif; ?>

<p><strong>Modules on the flash drive</strong>:
<?php if ($gu_modules === []): ?>none<?php else: ?>
<?php foreach ($gu_modules as $i => $m): ?><?= $i ? ', ' : '' ?><?= gu_h($m['kernel'] ?? '') ?><?= empty($m['ok']) ? ' (damaged)' : '' ?><?php endforeach; ?>
<?php endif; ?></p>

<div class="gu-buttons">
<input type="button" value="Generate firmware (Docker)" onclick="guAction('firmware')" title="Builds a small image with upstream's generators and runs it: downloads about 370 MB from NVIDIA (the driver installer and the kernel module source, both checked against pinned checksums), generates the firmware files and writes them to the flash drive. Needs the Docker service.">
<input type="button" value="Fetch module" onclick="guAction('fetch')" title="Download the module built for the running kernel from the GitHub release.">
<?php if (($gu['pending_kernel'] ?? '') !== ''): ?>
<input type="button" value="Fetch module for the staged kernel" onclick="guAction('fetch-pending')">
<?php endif; ?>
<input type="button" value="Check now" onclick="guAction('check')" title="What the daily cron job does: fetch missing modules for the running and the staged kernel.">
<?php if (empty($gu['disabled'])): ?>
<input type="button" value="Disable for the next boots" onclick="guAction('disable')">
<?php else: ?>
<input type="button" value="Enable" onclick="guAction('enable')">
<?php endif; ?>
<?php if (empty($gu['hook_installed'])): ?>
<input type="button" value="Install modprobe rule" onclick="guAction('hook-install')">
<?php endif; ?>
<input type="button" value="Refresh" onclick="location.reload()">
</div>
<pre id="gu-output" style="display:none"></pre>
<?php if ($gu_fwlog !== []): ?>
<p><strong>Firmware generation log</strong></p>
<pre class="gu-log"><?php foreach ($gu_fwlog as $l): ?><?= gu_h($l) ?>
<?php endforeach; ?></pre>
<?php endif; ?>

<p><strong>How to use it</strong></p>
<ol>
<li>Generate the firmware once (button above, needs the Docker service) and make sure the module for the running kernel is on the flash drive.</li>
<li>Tick the card(s) in the table and save. Nothing changes on the running system; the choice applies at the next boot. (The kernel command line still works: <code>gpu_unlock.targets=0000:01:00.0</code> on the boot entry overrides the choice made here.)</li>
<li>Reboot. The module refuses a card the NVIDIA driver already initialised since power-on; a plain reboot usually resets the card, and a full power off always does. If this page then says "power off required", shut down and power on.</li>
<li>Back here, the "This boot" column shows the per-card result, and the kernel log shows <code>gpu_unlock: unlocked</code> before <code>NVRM: loading NVIDIA</code>.</li>
</ol>
<p>After an Unraid update: click <em>Check now</em> before rebooting, so the module for the staged kernel is fetched; otherwise the first boot into the new kernel runs locked, the plugin fetches the module then and asks you for one more reboot. Builds for new kernels appear at <a href="<?= gu_h($gu['releases'] ?? '') ?>" target="_blank">the releases page</a> within a day.</p>
<p>Not affiliated with NVIDIA, Lime Technology or the gpu-unlock authors. Module: <a href="https://github.com/Zagitta/gpu-unlock" target="_blank">Zagitta/gpu-unlock</a> (GPL-2.0). The firmware is generated locally from NVIDIA's own downloads and is never redistributed.</p>

<script>
function guPost(data) {
  var out = $('#gu-output');
  out.show().text('Running ' + data.action + ' ...');
  data.csrf_token = csrf_token;
  $.post('/plugins/gpu-unlock/include/exec.php', data, null, 'json')
    .done(function (r) { out.text((r.output || '') + (r.ok ? '' : '\n(exit ' + r.rc + ')')); })
    .fail(function (xhr) {
      var r = xhr.responseJSON || {};
      out.text((r.output || r.error || ('request failed: ' + xhr.status)) + (r.rc !== undefined ? '\n(exit ' + r.rc + ')' : ''));
    });
}
function guAction(action) { guPost({action: action}); }
function guSaveTargets() {
  var list = [];
  if ($('#gu-all').is(':checked')) {
    list = ['all'];
  } else {
    $('.gu-card:checked').each(function () { list.push($(this).val()); });
  }
  if (list.length === 0) {
    guPost({action: 'targets-clear'});
  } else {
    guPost({action: 'targets', targets: list.join(',')});
  }
}
$('#gu-all').on('change', function () { $('.gu-card').prop('disabled', this.checked); });
if ($('#gu-all').is(':checked')) { $('.gu-card').prop('disabled', true); }
<?php if (!empty($gu['firmware_job'])): ?>
setTimeout(function () { location.reload(); }, 15000);
<?php endif; ?>
</script>
<?php endif; ?>
