Menu="Utilities"
Type="xmenu"
Title="GPU Unlock"
Icon="unlock"
Markdown="false"
---
<?PHP
/* SPDX-License-Identifier: GPL-2.0-only
 * GPU Unlock for Unraid: status and settings page. https://github.com/tabilzad/gpu-unlock-unraid
 *
 * Everything shown comes from `gpu-unlock-ctl status --json`, rendered by
 * include/render.php. The buttons post to include/exec.php (fixed action
 * table, CSRF enforced by Unraid); after every action, and while a firmware
 * generation runs, javascript/gpu-unlock.js swaps the content of #gu for a
 * fresh render from include/view.php, so the page never needs a reload.
 *
 * Styles: styles/gpu-unlock.css, scoped to .gu and themed through Unraid's
 * own theme variables, with fallbacks keyed by data-theme for Unraid 7.0.
 */
$docroot ??= ($_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp');
require_once "$docroot/plugins/gpu-unlock/include/render.php";

$gu_theme = gu_theme($display['theme'] ?? '');
$gu_css = '/plugins/gpu-unlock/styles/gpu-unlock.css?v=' . gu_asset_version("$docroot/plugins/gpu-unlock/styles/gpu-unlock.css");
$gu_js = '/plugins/gpu-unlock/javascript/gpu-unlock.js?v=' . gu_asset_version("$docroot/plugins/gpu-unlock/javascript/gpu-unlock.js");
?>
<link rel="stylesheet" href="<?= gu_h($gu_css) ?>">
<div id="gu" class="gu" data-theme="<?= gu_h($gu_theme) ?>">
<?= gu_render(gu_status()) ?>
</div>
<script src="<?= gu_h($gu_js) ?>"></script>
