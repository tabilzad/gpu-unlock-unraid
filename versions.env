# Pinned inputs for every build in this repository. Parsed with sed, never sourced.
# UPSTREAM_REF is the full commit of Zagitta/gpu-unlock whose kernel module and
# firmware generators are built; MODULE_VERSION must equal its VERSION file.
UPSTREAM_REPO=Zagitta/gpu-unlock
UPSTREAM_REF=990a14e9b7dc8eaad8e6925133aa0e8382efe6cf
MODULE_VERSION=1.0.0
NV=610.43.03
# Oldest Unraid kernel the module workflow builds for (Unraid 7.1.0 ships 6.12.24).
MIN_KERNEL=6.12.0
