# Pinned inputs for every build in this repository. Parsed with sed, never sourced.
# UPSTREAM_REF is the full commit of Zagitta/gpu-unlock whose kernel module and
# firmware generators are built; MODULE_VERSION must equal its VERSION file.
UPSTREAM_REPO=Zagitta/gpu-unlock
UPSTREAM_REF=0532473b4b105ed216948ed9c5aaeab0fa5c734f
MODULE_VERSION=2.0.0
NV=610.43.03
# The two NVIDIA downloads the firmware generator reads (named in upstream's
# firmware/fetch_artifacts.py, which no longer checks them): the generator
# refuses any other content.
NV_INSTALLER_SHA256=e084451db730a6df29d3d74f655749c4d236e3c945f7d94b5205e84318fe2f90
NV_SOURCE_SHA256=7e118923c7a23edc36114d63273a46e3e04e9af98695a42203e7ac2dfe9fc1dc
# The files the module at UPSTREAM_REF loads from gpu-unlock/<NV>/ (FIRMWARE_FILES
# in upstream's Makefile); a set on the flash drive that lacks any is "incomplete".
FIRMWARE_FILES=booter_load_ad102.bin booter_load_ga100.bin booter_load_ga102.bin booter_load_tu102.bin falcon_loader.bin gsp_boot_ad102.bin gsp_boot_desc_ad102.bin gsp_boot_desc_ga100.bin gsp_boot_desc_ga102.bin gsp_boot_desc_tu102.bin gsp_boot_ga100.bin gsp_boot_ga102.bin gsp_boot_tu102.bin gsp_ga10x.bin gsp_tu10x.bin sec2_bl_tu102.bin
# Oldest Unraid kernel the module workflow builds for (Unraid 7.1.0 ships 6.12.24).
MIN_KERNEL=6.12.0
